DATABASE_URL=sqlite:///./netsentinel.db
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# Generate a long random value and use the same key for backend and collector.
NETSENTINEL_API_KEY=replace-with-a-long-random-secret
NETSENTINEL_BACKEND_URL=http://localhost:8000
NETSENTINEL_INGEST_BATCH_SIZE=100
NETSENTINEL_INGEST_FLUSH_SECONDS=2
NETSENTINEL_INGEST_TIMEOUT_SECONDS=5
NETSENTINEL_INGEST_MAX_RETRIES=3
NETSENTINEL_INGEST_MAX_QUEUE_SIZE=5000
NETSENTINEL_HOST_ACTIVE_TIMEOUT_SECONDS=300

# Defensive metadata-only detection thresholds.
NETSENTINEL_DETECTION_ENABLED=true
NETSENTINEL_PORT_SCAN_WINDOW_SECONDS=60
NETSENTINEL_PORT_SCAN_UNIQUE_PORTS=20
NETSENTINEL_CONNECTION_SPIKE_WINDOW_SECONDS=60
NETSENTINEL_CONNECTION_SPIKE_BASELINE_SECONDS=600
NETSENTINEL_CONNECTION_SPIKE_MULTIPLIER=3
NETSENTINEL_CONNECTION_SPIKE_MIN_CONNECTIONS=30
NETSENTINEL_UNUSUAL_DESTINATION_PORTS=[23,445,1433,3389,5900]
NETSENTINEL_BANDWIDTH_OUTBOUND_BYTES=50000000
NETSENTINEL_BANDWIDTH_INBOUND_BYTES=100000000
NETSENTINEL_DETECTION_ALERT_COOLDOWN_SECONDS=300
