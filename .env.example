# Development-only placeholders. Replace both passwords/secrets before sharing a deployment.
POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=change-this-local-development-password

# Used when running FastAPI directly on the host. Compose supplies its own URL using `postgres`.
DATABASE_URL=postgresql+psycopg://netsentinel:change-this-local-development-password@localhost:5432/netsentinel
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
INTERNAL_API_URL=http://localhost:8000

# One-time enrollment secret. Each collector receives and stores its own API key.
NETSENTINEL_AGENT_ENROLLMENT_KEY=replace-with-a-long-random-enrollment-secret
NETSENTINEL_AGENT_ONLINE_TIMEOUT_SECONDS=90

# Dashboard user sessions are separate from every collector agent key.
# Generate AUTH_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETSENTINEL_AUTH_SECRET=replace-with-a-different-long-random-secret
NETSENTINEL_AUTH_SESSION_MINUTES=480
NETSENTINEL_AUTH_COOKIE_SECURE=false
NETSENTINEL_ADMIN_USERNAME=admin
NETSENTINEL_ADMIN_PASSWORD=change-this-development-admin-password

NETSENTINEL_BACKEND_URL=http://localhost:8000
NETSENTINEL_AGENT_STATE_PATH=~/.netsentinel/agent.json
NETSENTINEL_AGENT_HEARTBEAT_SECONDS=30
NETSENTINEL_INGEST_BATCH_SIZE=100
NETSENTINEL_INGEST_FLUSH_SECONDS=2
NETSENTINEL_INGEST_TIMEOUT_SECONDS=5
NETSENTINEL_INGEST_MAX_RETRIES=3
NETSENTINEL_INGEST_MAX_QUEUE_SIZE=5000
NETSENTINEL_PROCESS_CORRELATION_ENABLED=false
NETSENTINEL_PROCESS_REFRESH_SECONDS=2
NETSENTINEL_HOST_ACTIVE_TIMEOUT_SECONDS=300

# Defensive metadata-only detection thresholds.
NETSENTINEL_DETECTION_ENABLED=true
NETSENTINEL_CONNECTION_SPIKE_BASELINE_SECONDS=600
NETSENTINEL_CONNECTION_SPIKE_MULTIPLIER=3
NETSENTINEL_UNUSUAL_DESTINATION_PORTS=[23,445,1433,3389,5900]
NETSENTINEL_DETECTION_ALERT_COOLDOWN_SECONDS=300
NETSENTINEL_DNS_QUERY_RATE_WINDOW_SECONDS=60
NETSENTINEL_DNS_QUERY_RATE_THRESHOLD=100
NETSENTINEL_DNS_LONG_DOMAIN_LENGTH=80
NETSENTINEL_DNS_FAILURE_WINDOW_SECONDS=300
NETSENTINEL_DNS_FAILURE_THRESHOLD=10

# Optional HIGH/CRITICAL alert notifications. Keep the real webhook only in `.env`.
NETSENTINEL_DISCORD_WEBHOOK_URL=
NETSENTINEL_NOTIFICATION_RATE_LIMIT_SECONDS=300
NETSENTINEL_NOTIFICATION_TIMEOUT_SECONDS=5
